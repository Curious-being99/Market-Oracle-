# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# =========================================================================
# LIVE EXCHANGE INTEGRATION CREDENTIALS (PRODUCTION HARDENED ASSET BRIDGING)
# =========================================================================
# Set these keys to transition the order flow terminal from public read-only 
# telemetry and local simulation directly to your real, high-frequency account.
#
# BINANCE SECURE API CREDENTIALS (SPOT & COIN-M/USDT-M FUTURES ACCESS)
BINANCE_API_KEY=
BINANCE_API_SECRET=

# BITGET SECURE API CREDENTIALS (V2 SPOT SPOT BALANCES AND TELEMETRY)
BITGET_API_KEY=
BITGET_API_SECRET=
BITGET_API_PASSPHRASE=

# STATIC OUTBOUND PROXY (OPTIONAL)
# If your server requires a static egress IP
# but you are not deploying a full Cloud Run VPC with Cloud NAT, you can configure a socks5/http proxy here:
PROXY_URL=
HTTP_PROXY=

